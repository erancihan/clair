package pages

templ Chess() {
<div class="mt-16 sm:mt-16 sm:px-8">
    <div class="mx-auto max-w-7xl lg:px-8">
        <div class="relative px-4 sm:px-8 lg:px-12">
            <div class="mx-auto max-w-2xl lg:max-w-5xl">
                <div class="mb-8">
                    <h1 class="text-4xl font-bold tracking-tight text-zinc-800 dark:text-zinc-100 sm:text-5xl">
                        Chess
                    </h1>
                    <p class="mt-4 text-base text-zinc-600 dark:text-zinc-400">
                        Play a classic game of chess against a friend via link.
                    </p>
                </div>
                
                <div class="w-full" x-data="chess()">
                    <!-- Menu -->
                    <div x-show="!gameId" class="flex flex-col gap-4 max-w-sm mx-auto">
                        <button @click="createGame('pvp')" class="px-4 py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl transition-colors shadow-sm font-semibold tracking-wide">
                            Create PvP Game
                        </button>
                        <div class="relative flex items-center pt-2">
                            <div class="flex-grow border-t border-zinc-200 dark:border-zinc-800"></div>
                            <span class="flex-shrink-0 mx-4 text-zinc-400 text-sm">OR</span>
                            <div class="flex-grow border-t border-zinc-200 dark:border-zinc-800"></div>
                        </div>
                        <div class="flex gap-2">
                            <input type="text" x-model="joinId" placeholder="Enter Game ID to Join" class="flex-1 px-4 py-3 border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:text-zinc-100 placeholder-zinc-400 font-mono text-sm">
                            <button @click="joinGame" class="px-6 py-3 bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-900 text-white rounded-xl hover:bg-zinc-700 dark:hover:bg-zinc-200 transition-colors font-semibold">
                                Join
                            </button>
                        </div>
                    </div>

                    <!-- Game Area -->
                    <div x-show="gameId" x-cloak class="flex flex-col items-center max-w-2xl mx-auto mt-8 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 shadow-sm">
                        
                        <div class="w-full flex justify-between items-start mb-6 border-b border-zinc-100 dark:border-zinc-800 pb-4">
                            <div class="flex flex-col">
                                <span class="text-[10px] uppercase tracking-widest text-zinc-500 font-bold mb-1">Session ID</span>
                                <div class="flex items-center gap-2">
                                    <span class="text-xs font-mono bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-300 px-2 py-1 rounded" x-text="gameId"></span>
                                    <button @click="copyLink" class="text-zinc-400 hover:text-indigo-500 transition-colors" title="Copy Invite Link">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                                    </button>
                                </div>
                                <span x-show="copied" x-transition.opacity class="text-xs text-green-500 mt-1">Copied!</span>
                            </div>
                            <div class="flex flex-col items-end">
                                <span class="text-[10px] uppercase tracking-widest text-zinc-500 font-bold mb-1">Playing As</span>
                                <span class="text-lg font-black capitalize" :class="player === 'white' ? 'text-zinc-900 dark:text-zinc-100' : 'text-zinc-600 dark:text-zinc-400'" x-text="player"></span>
                            </div>
                        </div>

                        <!-- Waiting State for PvP -->
                        <div x-show="gameType === 0 && status === 'Waiting'" class="w-full mb-8 p-5 bg-indigo-50 dark:bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 rounded-2xl text-center border border-indigo-100 dark:border-indigo-500/20">
                            <div class="flex items-center justify-center mb-3">
                                <svg class="animate-spin h-5 w-5 text-indigo-600 dark:text-indigo-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                            </div>
                            <p class="text-sm font-semibold mb-1">Waiting for opponent...</p>
                            <p class="text-xs opacity-80">Copy the session ID or URL and send it to a friend to start playing.</p>
                        </div>

                        <!-- Turn / Status Indicator -->
                        <div x-show="status !== 'Waiting'" class="mb-6 w-full text-center">
                            <template x-if="status === 'Ongoing'">
                                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-zinc-100 dark:bg-zinc-800 text-sm font-medium">
                                    <span class="text-zinc-500">Turn:</span>
                                    <span class="font-bold capitalize" :class="turn === 'white' ? 'text-zinc-900 dark:text-zinc-100' : 'text-zinc-600 dark:text-zinc-400'" x-text="turn"></span>
                                    <span x-show="turn === player" class="ml-1 text-xs bg-indigo-100 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 px-2 py-0.5 rounded-full">(Your Turn)</span>
                                </div>
                            </template>
                            <template x-if="status !== 'Ongoing'">
                                <div class="text-2xl font-black text-indigo-600 dark:text-indigo-400" x-text="status"></div>
                            </template>
                        </div>

                        <!-- Clocks -->
                        <div x-show="status === 'Ongoing' || (status !== '' && status !== 'Waiting')" x-cloak class="w-full flex justify-center gap-3 mb-4">
                            <div class="px-4 py-2 rounded-lg font-mono text-lg font-bold flex items-center gap-1.5 transition-colors" :class="turn === 'white' && status === 'Ongoing' ? 'bg-indigo-600 text-white' : 'bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300'">
                                <span>♔</span><span x-text="fmtClock('white')"></span>
                            </div>
                            <div class="px-4 py-2 rounded-lg font-mono text-lg font-bold flex items-center gap-1.5 transition-colors" :class="turn === 'black' && status === 'Ongoing' ? 'bg-zinc-800 text-white dark:bg-zinc-100 dark:text-zinc-900' : 'bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300'">
                                <span>♚</span><span x-text="fmtClock('black')"></span>
                            </div>
                        </div>

                        <!-- Board Grid -->
                        <div class="relative w-full max-w-[480px] aspect-square rounded-lg border-4 border-zinc-200 dark:border-zinc-800 overflow-hidden mb-8 shadow-sm">
                            <div class="grid grid-cols-8 grid-rows-8 w-full h-full">
                                <template x-for="(cell, index) in getBoardCells()" :key="index">
                                    <button
                                        @click="handleCellClick(cell)"
                                        class="w-full h-full flex justify-center items-center relative transition-colors focus:outline-none"
                                        :class="{
                                            'bg-yellow-200/60 dark:bg-yellow-600/50': isSelected(cell),
                                            'bg-[#f0d9b5] dark:bg-zinc-300': !isSelected(cell) && isLightSquare(cell),
                                            'bg-[#b58863] dark:bg-zinc-600': !isSelected(cell) && !isLightSquare(cell),
                                            'cursor-pointer': (status === 'Ongoing' && turn === player && (isMyPiece(cell) || (selectedSquare && isValidMove(cell)))),
                                            'cursor-default': status !== 'Ongoing' || turn !== player || (!isMyPiece(cell) && (!selectedSquare || !isValidMove(cell)))
                                        }"
                                    >
                                        <!-- Highlight dot for valid move -->
                                        <div x-show="selectedSquare && isValidMove(cell) && !cell.piece" class="absolute inset-0 flex justify-center items-center pointer-events-none">
                                            <div class="w-1/4 h-1/4 rounded-full bg-black/20 dark:bg-black/40"></div>
                                        </div>
                                        <!-- Highlight ring for capturing -->
                                        <div x-show="selectedSquare && isValidMove(cell) && cell.piece" class="absolute inset-0 flex justify-center items-center pointer-events-none">
                                            <div class="w-5/6 h-5/6 rounded-full border-4 border-black/20 dark:border-black/40"></div>
                                        </div>
                                        
                                        <!-- Render Piece -->
                                        <div x-show="cell.piece" class="w-[85%] h-[85%] select-none pointer-events-none drop-shadow-sm" x-html="getPieceSVG(cell.piece)">
                                        </div>
                                        
                                        <!-- Coordinate labels -->
                                        <span x-show="cell.row === (player === 'black' ? 7 : 0)" class="absolute bottom-0.5 right-0.5 text-[10px] sm:text-xs font-semibold pointer-events-none select-none" :class="isLightSquare(cell) ? 'text-[#b58863] dark:text-zinc-600' : 'text-[#f0d9b5] dark:text-zinc-300'" x-text="indexToFile(cell.col)"></span>
                                        <span x-show="cell.col === (player === 'black' ? 7 : 0)" class="absolute top-0.5 left-0.5 text-[10px] sm:text-xs font-semibold pointer-events-none select-none" :class="isLightSquare(cell) ? 'text-[#b58863] dark:text-zinc-600' : 'text-[#f0d9b5] dark:text-zinc-300'" x-text="indexToRank(cell.row)"></span>
                                    </button>
                                </template>
                            </div>
                        </div>

                        <!-- Spectator badge -->
                        <div x-show="player === 'spectator'" x-cloak class="mb-4 px-3 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800 text-xs font-semibold text-zinc-500 uppercase tracking-widest">
                            Spectating
                        </div>

                        <!-- In-game controls: resign / draw offer (players only) -->
                        <div x-show="status === 'Ongoing' && (player === 'white' || player === 'black')" class="w-full flex flex-col items-center gap-3 mb-4">
                            <div x-show="drawOfferedBy && drawOfferedBy !== player" x-cloak class="w-full max-w-sm p-3 rounded-xl bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/20 text-center">
                                <p class="text-sm font-medium text-amber-800 dark:text-amber-300 mb-2">Your opponent offers a draw.</p>
                                <div class="flex justify-center gap-2">
                                    <button @click="sendAction('accept_draw')" class="px-3 py-1.5 text-sm rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-semibold transition-colors">Accept</button>
                                    <button @click="sendAction('decline_draw')" class="px-3 py-1.5 text-sm rounded-lg bg-zinc-200 dark:bg-zinc-700 hover:bg-zinc-300 dark:hover:bg-zinc-600 text-zinc-800 dark:text-zinc-100 font-semibold transition-colors">Decline</button>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <button @click="if (confirm('Resign this game?')) sendAction('resign')" class="px-4 py-2 text-sm rounded-lg bg-rose-600 hover:bg-rose-700 text-white font-semibold transition-colors">Resign</button>
                                <button x-show="!drawOfferedBy" @click="sendAction('offer_draw')" class="px-4 py-2 text-sm rounded-lg bg-zinc-200 dark:bg-zinc-700 hover:bg-zinc-300 dark:hover:bg-zinc-600 text-zinc-800 dark:text-zinc-100 font-semibold transition-colors">Offer Draw</button>
                                <span x-show="drawOfferedBy === player" x-cloak class="px-3 py-2 text-sm text-zinc-500 italic">Draw offered…</span>
                            </div>
                        </div>

                        <!-- Move history -->
                        <div x-show="moves.length > 0" x-cloak class="w-full max-w-sm mb-4">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-[10px] uppercase tracking-widest text-zinc-500 font-bold">Moves</span>
                                <button @click="copyPGN()" class="text-xs font-semibold text-indigo-500 hover:text-indigo-600">
                                    <span x-show="!pgnCopied">Copy PGN</span>
                                    <span x-show="pgnCopied" x-cloak class="text-green-500">Copied!</span>
                                </button>
                            </div>
                            <div class="max-h-32 overflow-y-auto text-sm font-mono bg-zinc-50 dark:bg-zinc-800/50 rounded-lg p-3 leading-7">
                                <template x-for="(m, i) in moves" :key="i">
                                    <span>
                                        <span x-show="i % 2 === 0" class="text-zinc-400 mr-1" x-text="(Math.floor(i/2)+1) + '.'"></span>
                                        <span class="text-zinc-800 dark:text-zinc-200 mr-2" x-text="m"></span>
                                    </span>
                                </template>
                            </div>
                        </div>

                        <button @click="resetSession" class="text-sm font-medium text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 transition-colors">
                            Leave Game
                        </button>

                        <!-- Promotion Picker -->
                        <div x-show="promotionMove" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-black/40" @click="cancelPromotion()">
                            <div class="bg-white dark:bg-zinc-900 rounded-2xl p-5 shadow-xl border border-zinc-200 dark:border-zinc-800" @click.stop>
                                <p class="text-sm font-semibold text-center mb-3 text-zinc-700 dark:text-zinc-200">Promote to</p>
                                <div class="flex gap-2">
                                    <template x-for="pt in ['queen','rook','bishop','knight']" :key="pt">
                                        <button @click="choosePromotion(pt)" class="w-16 h-16 flex items-center justify-center rounded-lg bg-zinc-100 dark:bg-zinc-800 hover:bg-indigo-100 dark:hover:bg-indigo-900/40 transition-colors">
                                            <div class="w-12 h-12" x-html="getPieceSVG({ color: player, type: pt })"></div>
                                        </button>
                                    </template>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <style>
                    [x-cloak] { display: none !important; }
                </style>

                <script>
                    document.addEventListener('alpine:init', () => {
                        Alpine.data('chess', () => ({
                            gameId: '',
                            joinId: '',
                            player: '',
                            token: '',
                            turn: 'white',
                            board: [],
                            validMoves: {},
                            status: '',
                            gameType: -1,
                            eventSource: null,
                            copied: false,
                            
                            selectedSquare: null, // Holds string like 'e2'
                            promotionMove: null, // { from, to } awaiting a promotion choice
                            drawOfferedBy: null, // 'white' | 'black' | null
                            whiteTimeMs: 0,
                            blackTimeMs: 0,
                            clockSyncAt: 0, // Date.now() when the last update arrived
                            clockNow: 0, // ticks every 250ms to drive the running clock
                            moves: [], // SAN move list
                            pgnCopied: false,

                            init() {
                                // Initialize empty board
                                for (let r = 0; r < 8; r++) {
                                    let row = [];
                                    for (let c = 0; c < 8; c++) row.push(null);
                                    this.board.push(row);
                                }

                                // Drive the running clock's display locally between updates.
                                this.clockNow = Date.now();
                                setInterval(() => { this.clockNow = Date.now(); }, 250);

                                const params = new URLSearchParams(window.location.search);
                                const id = params.get('id');
                                if (id) {
                                    // Reconnect with the seat + token we already hold (survives a
                                    // refresh); otherwise join the game fresh.
                                    const saved = localStorage.getItem('chess:' + id);
                                    if (saved) {
                                        try {
                                            const s = JSON.parse(saved);
                                            this.gameId = id;
                                            this.player = s.player;
                                            this.token = s.token || '';
                                            this.connectSSE();
                                            return;
                                        } catch (e) { /* fall through to a fresh join */ }
                                    }
                                    this.joinId = id;
                                    this.joinGame();
                                }
                            },

                            async createGame(gameMode) {
                                try {
                                    const res = await fetch('/games/chess/create', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({ game_mode: gameMode })
                                    });
                                    const data = await res.json();
                                    this.gameId = data.game_id;
                                    this.player = data.player; // 'white'
                                    this.token = data.token || '';
                                    localStorage.setItem('chess:' + this.gameId, JSON.stringify({ player: this.player, token: this.token }));

                                    const url = new URL(window.location);
                                    url.searchParams.set('id', this.gameId);
                                    window.history.pushState({}, '', url);

                                    this.connectSSE();
                                } catch (e) {
                                    console.error(e);
                                    alert("Failed to create game");
                                }
                            },

                            async joinGame() {
                                if (!this.joinId) return;
                                this.gameId = this.joinId;
                                try {
                                    const res = await fetch('/games/chess/join', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({ game_id: this.gameId })
                                    });
                                    if (!res.ok) throw new Error('join failed');
                                    const data = await res.json();
                                    this.player = data.player; // 'white' | 'black' | 'spectator'
                                    this.token = data.token || '';
                                    localStorage.setItem('chess:' + this.gameId, JSON.stringify({ player: this.player, token: this.token }));

                                    const url = new URL(window.location);
                                    url.searchParams.set('id', this.gameId);
                                    window.history.pushState({}, '', url);

                                    this.connectSSE();
                                } catch (e) {
                                    console.error(e);
                                    alert('Failed to join game');
                                }
                            },

                            connectSSE() {
                                if (this.eventSource) {
                                    this.eventSource.close();
                                }
                                this.eventSource = new EventSource(`/games/chess/stream?id=${this.gameId}`);
                                this.eventSource.onmessage = (e) => {
                                    const event = JSON.parse(e.data);
                                    if (event.type === 'update') {
                                        this.board = event.data.board.grid;
                                        this.validMoves = event.data.board.valid_moves;
                                        this.status = event.data.status;
                                        this.gameType = event.data.game_type;
                                        this.turn = event.data.turn;
                                        this.drawOfferedBy = event.data.draw_offered_by;
                                        this.whiteTimeMs = event.data.white_time_ms;
                                        this.blackTimeMs = event.data.black_time_ms;
                                        this.clockSyncAt = Date.now();
                                        this.moves = event.data.moves || [];
                                        // Deselect on opponent move
                                        this.selectedSquare = null;
                                    } else if (event.type === 'error') {
                                        alert(event.error);
                                        this.resetSession();
                                    }
                                };
                                this.eventSource.onerror = (e) => {
                                    console.error("SSE error", e);
                                    this.status = "Connection Error";
                                    this.eventSource.close();
                                };
                            },

                            // Board representation mapping
                            getBoardCells() {
                                let cells = [];
                                // If player is black, reverse the board purely visually
                                const startRow = this.player === 'black' ? 0 : 7;
                                const endRow = this.player === 'black' ? 8 : -1;
                                const stepRow = this.player === 'black' ? 1 : -1;
                                
                                const startCol = this.player === 'black' ? 7 : 0;
                                const endCol = this.player === 'black' ? -1 : 8;
                                const stepCol = this.player === 'black' ? -1 : 1;

                                for (let r = startRow; r !== endRow; r += stepRow) {
                                    for (let c = startCol; c !== endCol; c += stepCol) {
                                        cells.push({
                                            row: r,
                                            col: c,
                                            piece: this.board[r] ? this.board[r][c] : null,
                                            posString: String.fromCharCode(c + 97) + (r + 1).toString()
                                        });
                                    }
                                }
                                return cells;
                            },

                            isLightSquare(cell) {
                                return (cell.row + cell.col) % 2 !== 0; // standard chess logic where bottom left is dark
                            },
                            
                            isMyPiece(cell) {
                                return cell.piece && cell.piece.color === this.player;
                            },

                            isSelected(cell) {
                                return this.selectedSquare === cell.posString;
                            },

                            isValidMove(cell) {
                                if (!this.selectedSquare || !this.validMoves) return false;
                                const moves = this.validMoves[this.selectedSquare];
                                return moves && moves.includes(cell.posString);
                            },

                            indexToFile(colIndex) {
                                return String.fromCharCode(colIndex + 97); // 'a' - 'h'
                            },

                            indexToRank(rowIndex) {
                                return (rowIndex + 1).toString(); // '1' - '8'
                            },

                            handleCellClick(cell) {
                                if (this.status !== 'Ongoing' || this.turn !== this.player) return;

                                const posStr = cell.posString;

                                // If I clicked a valid move destination, perform the move
                                if (this.selectedSquare && this.isValidMove(cell)) {
                                    const moving = this.pieceAt(this.selectedSquare);
                                    const lastRank = this.player === 'white' ? 7 : 0;
                                    if (moving && moving.type === 'pawn' && cell.row === lastRank) {
                                        // Pawn reaching the last rank: ask which piece to promote to.
                                        this.promotionMove = { from: this.selectedSquare, to: posStr };
                                        return;
                                    }
                                    this.makeMove(this.selectedSquare, posStr);
                                    this.selectedSquare = null;
                                    return;
                                }

                                // If I clicked my own piece, select it
                                if (this.isMyPiece(cell)) {
                                    // toggle off if already selected
                                    if (this.selectedSquare === posStr) {
                                        this.selectedSquare = null;
                                    } else {
                                        this.selectedSquare = posStr;
                                    }
                                } else {
                                    // Clicked an empty square or enemy piece not in valid moves
                                    this.selectedSquare = null;
                                }
                            },

                            async makeMove(from, to, promotion = '') {
                                try {
                                    await fetch('/games/chess/move', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({
                                            game_id: this.gameId,
                                            token: this.token,
                                            from: from,
                                            to: to,
                                            promotion: promotion
                                        })
                                    });
                                } catch (e) {
                                    console.error(e);
                                }
                            },

                            pieceAt(posStr) {
                                const col = posStr.charCodeAt(0) - 97;
                                const row = parseInt(posStr[1], 10) - 1;
                                return this.board[row] ? this.board[row][col] : null;
                            },

                            choosePromotion(piece) {
                                if (!this.promotionMove) return;
                                this.makeMove(this.promotionMove.from, this.promotionMove.to, piece);
                                this.promotionMove = null;
                                this.selectedSquare = null;
                            },

                            cancelPromotion() {
                                this.promotionMove = null;
                                this.selectedSquare = null;
                            },

                            async sendAction(action) {
                                try {
                                    await fetch('/games/chess/move', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({
                                            game_id: this.gameId,
                                            token: this.token,
                                            action: action
                                        })
                                    });
                                } catch (e) {
                                    console.error(e);
                                }
                            },

                            fmtClock(color) {
                                let ms = color === 'white' ? this.whiteTimeMs : this.blackTimeMs;
                                if (this.status === 'Ongoing' && this.turn === color) {
                                    ms -= (this.clockNow - this.clockSyncAt);
                                }
                                if (ms < 0) ms = 0;
                                const totalSec = Math.floor(ms / 1000);
                                const m = Math.floor(totalSec / 60);
                                const s = totalSec % 60;
                                return m + ':' + String(s).padStart(2, '0');
                            },

                            async copyPGN() {
                                try {
                                    const res = await fetch('/games/chess/pgn?id=' + encodeURIComponent(this.gameId));
                                    const pgn = await res.text();
                                    await navigator.clipboard.writeText(pgn);
                                    this.pgnCopied = true;
                                    setTimeout(() => this.pgnCopied = false, 2000);
                                } catch (e) {
                                    console.error(e);
                                }
                            },

                            copyLink() {
                                navigator.clipboard.writeText(window.location.href);
                                this.copied = true;
                                setTimeout(() => this.copied = false, 2000);
                            },

                            resetSession() {
                                if (this.eventSource) {
                                    this.eventSource.close();
                                    this.eventSource = null;
                                }
                                if (this.gameId) {
                                    localStorage.removeItem('chess:' + this.gameId);
                                }
                                this.gameId = '';
                                this.joinId = '';
                                this.player = '';
                                this.token = '';
                                this.board = [];
                                for (let r = 0; r < 8; r++) {
                                    let row = [];
                                    for (let c = 0; c < 8; c++) row.push(null);
                                    this.board.push(row);
                                }
                                this.validMoves = {};
                                this.status = '';
                                this.selectedSquare = null;
                                this.promotionMove = null;
                                this.drawOfferedBy = null;
                                this.whiteTimeMs = 0;
                                this.blackTimeMs = 0;
                                this.moves = [];

                                const url = new URL(window.location);
                                url.searchParams.delete('id');
                                window.history.pushState({}, '', url);
                            },

                            // Piece SVG Generators
                            getPieceSVG(piece) {
                                if (!piece) return '';
                                const isWhite = piece.color === 'white';
                                const c1 = isWhite ? '#fff' : '#000';
                                const c2 = isWhite ? '#000' : '#fff';
                                
                                switch (piece.type) {
                                    case 'pawn':
                                        return `<svg viewBox="0 0 45 45"><path d="M22.5 9c-2.21 0-4 1.79-4 4 0 .89.29 1.71.78 2.38C17.33 16.5 16 18.59 16 21c0 2.03.94 3.84 2.41 5.03-3 1.06-7.41 5.55-7.41 13.47h23c0-7.92-4.41-12.41-7.41-13.47 1.47-1.19 2.41-3 2.41-5.03 0-2.41-1.33-4.5-3.28-5.62.49-.67.78-1.49.78-2.38 0-2.21-1.79-4-4-4z" fill="${c1}" stroke="${c2}" stroke-width="1.5"/></svg>`;
                                    case 'rook':
                                        return `<svg viewBox="0 0 45 45"><path d="M9 39h27v-3H9v3zM12 36v-4h21v4H12zM11 14V9h4v2h5V9h5v2h5V9h4v5" fill="${c1}" stroke="${c2}" stroke-width="1.5"/><path d="M34 14l-3 3H14l-3-3M31 17v12.5H14V17" fill="${c1}" stroke="${c2}" stroke-width="1.5"/></svg>`;
                                    case 'knight':
                                        return `<svg viewBox="0 0 45 45"><path d="M 22,10 C 32.5,11 38.5,18 38,39 L 15,39 C 15,30 25,32.5 23,18" fill="${c1}" stroke="${c2}" stroke-width="1.5"/><path d="M 24,18 C 24.38,20.91 18.45,25.37 16,27 C 13,29 13.18,31.34 11,31 C 9.95,30.06 12.41,27.96 11,28 C 10,28 11.19,29.23 10,30 C 9,30 5.99,27.88 6,26 C 6,24 12,14 12,14 C 12,14 13.89,12.1 14,10.5 C 13.27,9.506 13.5,8.5 13.5,7.5 C 14.5,6.5 16.5,10 16.5,10 L 18.5,10 C 18.5,10 19.28,8.008 21,7 C 22,7 22,10 22,10" fill="${c1}" stroke="${c2}" stroke-width="1.5"/><circle cx="14" cy="15.5" r="1" fill="${c2}"/></svg>`;
                                    case 'bishop':
                                        return `<svg viewBox="0 0 45 45"><path d="M9 36c3.39-.97 10.11.43 13.5-2 3.39 2.43 10.11 1.03 13.5 2 0 0 1.65.54 3 2-.68.97-1.65.99-3 .5-3.39-.97-10.11.46-13.5-1-3.39 1.46-10.11.03-13.5 1-1.35.49-2.32.47-3-.5 1.35-1.46 3-2 3-2zM15 32c2.5 2.5 12.5 2.5 15 0 .5-1.5 0-2 0-2 0-2.5-2.5-4-2.5-4 5.5-1.5 6-11.5-5-15.5-11 4-10.5 14-5 15.5 0 0-2.5 1.5-2.5 4 0 0-.5.5 0 2zM25 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 1 1 5 0z" fill="${c1}" stroke="${c2}" stroke-width="1.5"/></svg>`;
                                    case 'queen':
                                        return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 45 45"><g fill="${c1}" fill-rule="evenodd" stroke="${c2}" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"><path d="M8 12a2 2 0 1 1-4 0 2 2 0 1 1 4 0m16.5-4.5a2 2 0 1 1-4 0 2 2 0 1 1 4 0M41 12a2 2 0 1 1-4 0 2 2 0 1 1 4 0M16 8.5a2 2 0 1 1-4 0 2 2 0 1 1 4 0M33 9a2 2 0 1 1-4 0 2 2 0 1 1 4 0"/><path stroke-linecap="butt" d="M9 26c8.5-1.5 21-1.5 27 0l2-12-7 11V11l-5.5 13.5-3-15-3 15-5.5-14V25L7 14z"/><path stroke-linecap="butt" d="M9 26c0 2 1.5 2 2.5 4 1 1.5 1 1 .5 3.5-1.5 1-1.5 2.5-1.5 2.5-1.5 1.5.5 2.5.5 2.5 6.5 1 16.5 1 23 0 0 0 1.5-1 0-2.5 0 0 .5-1.5-1-2.5-.5-2.5-.5-2 .5-3.5 1-2 2.5-2 2.5-4-8.5-1.5-18.5-1.5-27 0z"/><path fill="none" d="M11.5 30c3.5-1 18.5-1 22 0M12 33.5c6-1 15-1 21 0"/></g></svg>`;
                                    case 'king':
                                        return `<svg viewBox="0 0 45 45"><path d="M22.5 11.63V6M20 8h5M22.5 25s4.5-7.5 3-10.5c0 0-1-2.5-3-2.5s-3 2.5-3 2.5c-1.5 3 3 10.5 3 10.5" fill="none" stroke="${c2}" stroke-width="1.5" stroke-linecap="round"/><path d="M11.5 37c5.5 3.5 15.5 3.5 21 0v-7s9-4.5 6-10.5c-4-6.5-13.5-3.5-16 4V27v-3.5c-3.5-7.5-13-10.5-16-4-3 6 5 10.5 5 10.5z" fill="${c1}" stroke="${c2}" stroke-width="1.5"/><path d="M11.5 30c5.5-3 15.5-3 21 0M12.5 33.5c4.5-2.5 13.5-2.5 18 0M11.5 37c5.5 3.5 15.5 3.5 21 0" fill="none" stroke="${c2}" stroke-width="1.5"/></svg>`;
                                }
                                return '';
                            }
                        }));
                    });
                </script>
            </div>
        </div>
    </div>
</div>
}