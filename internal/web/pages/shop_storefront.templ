package pages

// ShopLanding is the storefront's front page. Phase 0 ships the shell and the
// heading only; featured products and category links arrive with the catalog
// (docs/shop-plan.md §5, Phase 2).
templ ShopLanding() {
	<div class="mt-16 sm:mt-16 sm:px-8">
		<div class="mx-auto max-w-7xl lg:px-8">
			<div class="relative px-4 sm:px-8 lg:px-12">
				<div class="mx-auto max-w-2xl lg:max-w-5xl">
					<div class="mb-8">
						<h1 class="text-4xl font-bold tracking-tight text-zinc-800 dark:text-zinc-100 sm:text-5xl">Shop</h1>
						<p class="mt-4 text-base text-zinc-600 dark:text-zinc-400">
							The storefront is being stocked. Check back soon.
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>
}
