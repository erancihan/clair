package pages

// aurenorPage is the shared frame for every Aurenor landing: the standard page
// shell, a title and subtitle, then the caller's body.
//
// notice is the caveat badge for a page that cannot do the whole job yet — the
// theater holds real seats but takes no payment. It is passed per page and
// spelled out per page, because "not finished" means something different on each
// one; empty means the page does what it appears to do.
templ aurenorPage(title string, subtitle string, notice string) {
	<div class="mt-16 sm:mt-16 sm:px-8">
		<div class="mx-auto max-w-7xl lg:px-8">
			<div class="relative px-4 sm:px-8 lg:px-12">
				<div class="mx-auto max-w-2xl lg:max-w-5xl">
					<div class="mb-10">
						if notice != "" {
							<span class="inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-xs font-medium text-amber-800 dark:bg-amber-400/10 dark:text-amber-300">
								{ notice }
							</span>
						}
						<h1 class="mt-4 text-4xl font-bold tracking-tight text-zinc-800 dark:text-zinc-100 sm:text-5xl">
							{ title }
						</h1>
						<p class="mt-4 text-base text-zinc-600 dark:text-zinc-400">
							{ subtitle }
						</p>
					</div>
				</div>
				<div class="mx-auto max-w-2xl lg:max-w-5xl space-y-14">
					{ children... }
				</div>
			</div>
		</div>
	</div>
}

// institutionCard is one entry in a collection list (a theater, a hospital),
// linking to that institution's detail page.
templ institutionCard(href string, name string, location string, blurb string) {
	<a href={ templ.SafeURL(href) }
		class="group block bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 shadow-sm transition hover:border-teal-500/40">
		<h3 class="text-xl font-semibold text-zinc-800 transition group-hover:text-teal-500 dark:text-zinc-100 dark:group-hover:text-teal-400">
			{ name }
		</h3>
		<p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">{ location }</p>
		<p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400">{ blurb }</p>
	</a>
}

// apptGrid lists an institution's services.
//
// It renders links and nothing else. A page that showed availability for every
// service would have to subscribe to every service, and nobody is looking at
// more than one at a time.
templ apptGrid(cards []ServiceCard) {
	<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
		for _, c := range cards {
			<a href={ templ.SafeURL(ServiceHref(c)) }
				class="group flex items-start justify-between gap-4 rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm transition hover:border-teal-500/40 dark:border-zinc-800 dark:bg-zinc-800">
				<span class="min-w-0">
					<span class="block font-semibold text-zinc-800 transition group-hover:text-teal-500 dark:text-zinc-100 dark:group-hover:text-teal-400">{ c.Title }</span>
					<span class="mt-1 block text-sm text-zinc-500 dark:text-zinc-400">{ c.Blurb }</span>
				</span>
				<span class="flex-none text-zinc-300 transition group-hover:text-teal-500 dark:text-zinc-600" aria-hidden="true">→</span>
			</a>
		}
	</div>
}

