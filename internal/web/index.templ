package web

import components "github.com/erancihan/clair/internal/web/components"

var FAVICON_SVG=`data:image/svg+xml;utf8,<svg fill='#fb7e14' height='256px' width='256px' version='1.1' id='Layer_1' xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' viewBox='-81.55 -81.55 517.67 517.67' xml:space='preserve' stroke='#fb7e14' stroke-width='0.0035457'><g id='SVGRepo_bgCarrier' stroke-width='0' transform='translate(0,0), scale(1)'></g><g id='SVGRepo_tracerCarrier' stroke-linecap='round' stroke-linejoin='round' stroke='#000000' stroke-width='10.6371'> <g> <g> <path d='M309.647,33.096c-2.304-2.376-4.823-4.541-7.439-6.533c-28.682-22.113-70.19-19.948-96.845,6.497 c-19.845,19.635-26.414,47.652-19.425,72.596c2.376,8.663,6.395,16.942,12.017,24.387l0.138,0.138 c0.522,0.522,0.942,1.08,1.29,1.644c2.34,3.666,1.956,8.315-1.326,11.53l-5.478,5.76l25.923,25.923l11.628-11.628 c14.536-14.392,14.71-37.699,0.486-52.055l0.036-0.036c-14.29-14.428-14.008-37.765,0.522-52.163 c13.624-13.486,34.831-14.362,49.193-2.657l68.931,26.798c0,0,3.354-3.425,5.274-5.274L309.647,33.096z'></path> <path d='M35.323,306.509c-9.574,9.574-23.127,12.718-35.323,9.467c1.572,6.042,4.716,11.704,9.431,16.42 c14.254,14.254,37.345,14.29,51.671,0.102l0.102-0.102l9.569-9.636l-25.866-25.866L35.323,306.509z'></path> <path d='M185.656,156.038c-0.113,0.046-0.251,0.072-0.369,0.118L82.422,259.277l-21.207,21.274l-9.318,9.344l25.789,25.789 c0.108-0.046,0.241-0.072,0.353-0.113l133.484-133.545L185.6,156.104L185.656,156.038z'></path> </g> </g> </g><g id='SVGRepo_iconCarrier'> <g> <g> <path d='M309.647,33.096c-2.304-2.376-4.823-4.541-7.439-6.533c-28.682-22.113-70.19-19.948-96.845,6.497 c-19.845,19.635-26.414,47.652-19.425,72.596c2.376,8.663,6.395,16.942,12.017,24.387l0.138,0.138 c0.522,0.522,0.942,1.08,1.29,1.644c2.34,3.666,1.956,8.315-1.326,11.53l-5.478,5.76l25.923,25.923l11.628-11.628 c14.536-14.392,14.71-37.699,0.486-52.055l0.036-0.036c-14.29-14.428-14.008-37.765,0.522-52.163 c13.624-13.486,34.831-14.362,49.193-2.657l68.931,26.798c0,0,3.354-3.425,5.274-5.274L309.647,33.096z'></path> <