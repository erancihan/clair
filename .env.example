# Application environment. Set to "production" to enable fail-closed security
# (a SESSION_KEY becomes mandatory and cookies are marked Secure).
APP_ENV=development

# Session / security configuration
## Signing key for session cookies. REQUIRED when APP_ENV=production (the server
## panics on startup if it is unset). Outside production a development fallback is
## used. Generate one with, e.g., `openssl rand -base64 48`.
SESSION_KEY=

# Database configuration
## PostgreSQL connection string (required)
DATABASE_URL=postgres://clair:clair@localhost:5432/clair?sslmode=disable

## Optional. When true, the schema is applied on every startup. Off by default:
## migrations are a deliberate step (`make migrate`, or `clair migrate`) so a
## rebuild or a restart never rewrites tables under a running deployment. Turn it
## on only for a throwaway local database.
DATABASE_AUTO_MIGRATE=false

## Optional. How much GORM logs: silent, error, warn (default) or info (every
## statement). Leave it at warn outside a debugging session.
DATABASE_LOG_LEVEL=warn

# Booking configuration
## Shared secret the payment provider signs its webhook deliveries with
## (HMAC-SHA256 over the raw body, sent as X-Payment-Signature). The booking
## payment webhook is the only route that turns a hold into a paid appointment or
## ticket, so it refuses every delivery while this is unset rather than falling
## back to a guessable default.
BOOKING_PAYMENT_WEBHOOK_SECRET=

## Optional. Email of the host user that owns the seeded Aurenor schedules and
## events (see `make seed`). Defaults to host@aurenor.example when unset.
SEED_HOST_EMAIL=

## Optional. When true, `clair scheduler` deletes booking history (orders,
## payments, tickets, appointments, holds) once the showing started or the slot
## ended more than RETENTION_DAYS ago. Off by default: it is the one job that
## destroys data, so turning it on is a deliberate choice. Schedules, rules,
## events, tiers and seats are never deleted.
RETENTION_ENABLED=false

## Optional. Days of booking history to keep when retention is on. Default 90.
RETENTION_DAYS=90

# ValKey configuration
VALKEY_PORT=6379
VALKEY_HOST=localhost # 'valkey' if using docker compose

# Server configuration
SERVER_PORT=4000

# Rate limits (per client address)
## Guest writes: holds, releases, bookings, cancellations, waitlist joins.
RATE_LIMIT_GUEST_RPS=5
RATE_LIMIT_GUEST_BURST=20
## Open event streams one address may hold at once.
RATE_LIMIT_STREAMS_PER_IP=12
## Set to true only behind a proxy you control; the first X-Forwarded-For hop
## then keys the limits instead of the socket address.
TRUST_PROXY_HEADERS=false

# Files
## Optional. Directory served at /public/. Defaults to internal/web/public.
PUBLIC_PATH=

# Tests
## Optional. Database the test suite uses when set; otherwise DATABASE_URL.
TEST_DATABASE_URL=
